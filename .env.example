# Copy to .env and adjust. Every value can also be set as an environment variable.
# Never commit .env (it is gitignored; this repository is PUBLIC).

# --- application ---------------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                    # true in containers (structured JSON logs)
CORS_ORIGINS=http://localhost:3000
# Freeze "now" to the seed reference date so the demo scenarios' refund windows
# make sense. Leave EMPTY in production.
REFERENCE_NOW=2026-11-19T18:00:00Z

# --- database (PostgreSQL in every real environment) ---------------------------
DATABASE_URL=postgresql+asyncpg://wines:wines@localhost:5433/wines_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- auth ----------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-value
JWT_ISSUER=wines-ai-platform
JWT_AUDIENCE=wines-ai-api
ACCESS_TOKEN_TTL_S=3600
AGENT_TOKEN_TTL_S=300             # delegated agent tokens are short-lived
ENABLE_DEV_AUTH=true              # POST /api/v1/auth/dev-token; MUST be false in production

# --- rate limiting (redis is required with more than one replica) ---------------
RATE_LIMIT_BACKEND=memory         # memory | redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_TOOL_PER_MINUTE=240
RATE_LIMIT_CHAT_PER_MINUTE=30

# --- agent -> tool API -----------------------------------------------------------
# Empty = in-process ASGI transport (same pod). Set to split agent and tool tiers,
# e.g. http://tool-api.internal:8000
TOOL_API_BASE_URL=
TOOL_API_TIMEOUT_S=8
TOOL_API_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_S=30

# --- LLM -----------------------------------------------------------------------
LLM_PROVIDER=auto                 # auto (anthropic if a key is set) | anthropic | rule_based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium           # low | medium | high | xhigh | max
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_FALLBACKS_ENABLED=true  # server-side refusal fallback
AGENT_MAX_ITERATIONS=8
AGENT_HISTORY_TURNS=10

# --- knowledge base --------------------------------------------------------------
KB_PATH=_KB
KB_TOP_K=4
